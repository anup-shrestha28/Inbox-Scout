# Run the complete interface with safe sample data and no external credentials.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project settings (required when demo mode is false).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Search discovery.
BRAVE_SEARCH_API_KEY=

# Gmail OAuth. The callback must match the value configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Long random secret shared by Supabase Cron and the background functions.
CRON_SECRET=

# Public application URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
